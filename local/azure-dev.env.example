# Settings for running against the Azure dev resources from your Mac.
# Copy to local/azure-dev.env (git-ignored) and fill in the <...> values.
# Nothing here is a secret: credentials come from `az login` (you) and the
# certificate file, which lives OUTSIDE the repo.
DEPLOYMENT_ENVIRONMENT=development

# Azure Database for PostgreSQL (Entra sign-in as you; see docs/RUN_24H_TEST.md step 2)
DATABASE_AUTH=entra
PGHOST=psql-fs-ci-dev-1026b.postgres.database.azure.com
PGPORT=5432
PGUSER=<your sign-in, e.g. matthews@finishessolutions.com>
PGDATABASE=ci
PGSSLMODE=require

# Microsoft Graph: the test app registration (step 1)
GRAPH_BACKEND=graph
GRAPH_TENANT_ID=<directory (tenant) id>
GRAPH_CLIENT_ID=<application (client) id of "FS CI Email Ingestion Test">
GRAPH_CERTIFICATE_PATH=<absolute path, e.g. /Users/you/.fs-ci/ci-graph.pem>

# Azure AI services (step 3). Endpoints from the portal "Keys and Endpoint" page.
AZURE_OPENAI_ENDPOINT=https://aoai-fs-ci-dev-1026.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=<chat deployment name, e.g. gpt-4.1-mini>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_LANGUAGE_ENDPOINT=https://lang-fs-ci-dev-1026.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_ENDPOINT=https://safe-fs-ci-dev-1026.cognitiveservices.azure.com/

# Attachment text extraction without OCR or malware scanning (approved exception to L11).
ATTACHMENT_EXTRACTION_ENABLED=true
ATTACHMENT_UNSUPPORTED_POLICY=publish_partial
EMAIL_INCLUDE_SENT=true
AUTH_MODE=entra
