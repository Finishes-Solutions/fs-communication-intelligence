# Local development settings for `make` targets and `uv run --env-file local/local.env`.
# The password only opens the throwaway local container (127.0.0.1, synthetic
# data). Never put a real credential in this file.
DEPLOYMENT_ENVIRONMENT=local
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=postgres
PGPASSWORD=ci-local-only
PGDATABASE=ci_local
