                           scope_state, test_approved, backfill_since, policy_version) VALUES
  ('00000000-0000-0000-0000-00000000005a', '00000000-0000-0000-0000-0000000000e1', 'mailbox', 'oid-a', 'Mailbox A', '00000000-0000-0000-0000-0000000000c0', 'enrolled', true,  '2026-01-01', 'p1'),
  ('00000000-0000-0000-0000-00000000005b', '00000000-0000-0000-0000-0000000000e1', 'mailbox', 'oid-b', 'Mailbox B', '00000000-0000-0000-0000-0000000000c0', 'enrolled', true,  '2026-01-01', 'p1'),
  ('00000000-0000-0000-0000-00000000005c', '00000000-0000-0000-0000-0000000000e1', 'mailbox', 'oid-u', 'Mailbox U', '00000000-0000-0000-0000-0000000000c0', 'enrolled', false, '2026-01-01', 'p1');

-- evidence (ingestion role)
SET ROLE t_ingest;
