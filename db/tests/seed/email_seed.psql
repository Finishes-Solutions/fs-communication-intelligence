INSERT INTO email_attachments (version_id, native_attachment_id, name, content_type, size_bytes, is_inline, content_id, status) VALUES
  ('00000000-0000-0000-0000-0000000000b1', 'att-1', 'Invoice-4471.pdf', 'application/pdf', 84211, false, NULL, 'metadata_only'),
  ('00000000-0000-0000-0000-0000000000b1', 'att-2', 'image001.png', 'image/png', 5120, true, 'image001.png@x', 'unsupported_partial');
CREATE TEMP TABLE qv AS SELECT (SELECT array_agg(random())::vector(1536) FROM generate_series(1, 1536)) v;
INSERT INTO chunks (version_id, communication_id, chunk_kind, seq, display_text,
                    embedding_input_sha256, embedding_model, embedding)
SELECT ('00000000-0000-0000-0000-0000000000b' || n)::uuid, ('00000000-0000-0000-0000-0000000000a' || n)::uuid,
       'email_body', 0,
       (ARRAY['Invoice 4471 for grading at Example Ridge Lot 12, total 18,250 due Friday.',
              'Invoice 4471 for grading at Example Ridge Lot 12, total 18,250 due Friday.',
              'The payroll calendar for November has been updated.',
              'Question about an invoice sent to the shared inbox.',
              'Dispute over the invoice for the retaining wall.'])[n],
       'h' || n, 'te3l-1536', (SELECT v FROM qv)
FROM generate_series(1, 5) n;
RESET ROLE;
GRANT SELECT ON qv TO t_search;
