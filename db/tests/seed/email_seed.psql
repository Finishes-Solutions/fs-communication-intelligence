-- Synthetic email seed shared by the check files (included with \ir).
-- Invented people, vendors and amounts only. Random vectors stand in for
-- embeddings. Nothing is published here; see publish.psql.
--
-- Mailboxes: A (pat, enrolled, test-approved), B (sam, enrolled,
-- test-approved), U (enrolled, NOT approved).
-- Messages:
--   M1  A  invoice from jordan@acme-sitework.example        corpus C0
--   M2  B  copy of M1 (same Internet Message-ID)             corpus C0
--   M3  A  payroll notice from hr@payroll-vendor.example     corpus C0
--   M4  U  message in the unapproved mailbox                 corpus C0
--   M5  A  restricted-corpus message                         corpus C1
SET search_path = ci, public;
CREATE ROLE t_ingest LOGIN IN ROLE ci_ingest;
CREATE ROLE t_search LOGIN IN ROLE ci_search;
CREATE ROLE t_operator LOGIN IN ROLE ci_operator;

-- control plane (operator decisions)
INSERT INTO runtime_config (mode, enabled_providers, is_active, activated_at, activated_by)
  VALUES ('test', '{email}', true, now(), 'op');
INSERT INTO source_connections (id, provider, account_ref, display_name, enabled)
  VALUES ('00000000-0000-0000-0000-0000000000e1', 'email', 'tenant-1', 'M365 email', true);
