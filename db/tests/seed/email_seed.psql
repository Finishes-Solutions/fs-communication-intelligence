INSERT INTO communication_versions (id, communication_id, version_no, source_revision, profile, processing_state)
SELECT ('00000000-0000-0000-0000-0000000000b' || n)::uuid, ('00000000-0000-0000-0000-0000000000a' || n)::uuid,
       1, 'sha-r' || n, '{"chunker":"para-1","embed":"te3l-1536","policy":"p1"}', 'embedded'
FROM generate_series(1, 5) n;
