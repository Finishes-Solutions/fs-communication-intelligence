# PROPOSED CONFIGURATION CONTRACT — no application consumes this file yet.
# Local development uses environment variables. Deployed apps read coordinated
# runtime controls from shared configuration; see docs/ARCHITECTURE_DECISIONS.md.
# Deployment environment is infrastructure identity, not ingestion scope.
DEPLOYMENT_ENVIRONMENT=development
INGESTION_MODE=test

# First release: Fireflies only (ADR-010). Deployed apps read the active mode
# from the PostgreSQL runtime_config revision (ADR-011); these are local names.
SOURCE_FIREFLIES_ENABLED=true
SOURCE_EMAIL_ENABLED=false
SOURCE_TEAMS_ENABLED=false
SOURCE_DIALPAD_ENABLED=false

# --- Fireflies (docs/FIREFLIES_PIPELINE.md) ---
FIREFLIES_API_URL=https://api.fireflies.ai/graphql
# Key Vault secret NAMES, never the values.
FIREFLIES_API_KEY_SECRET_NAME=fireflies-api-key
FIREFLIES_WEBHOOK_SECRET_NAME=fireflies-webhook-secret
# Empty scope MUST reject capture. Approved Fireflies user IDs.
FIREFLIES_TEST_USER_IDS=
# Fixed UTC boundary; empty MUST block initial capture.
FIREFLIES_BACKFILL_SINCE=
# Set from the verified plan (FF-001). Backfill may not use the live reserve.
FIREFLIES_RATE_LIMIT_PER_MINUTE=60
FIREFLIES_RATE_RESERVE_FOR_LIVE=20
FIREFLIES_RECONCILE_WINDOW_DAYS=14

# --- Search and embeddings (docs/SEARCH_AND_AGENTS.md) ---
EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
SEARCH_READER_APP_ROLE=Communications.Reader.Executive

# --- Email (second release; disabled) ---
# Empty scope MUST reject capture. Supply approved Entra mailbox object IDs.
TEST_MAILBOX_IDS=

# Set a fixed UTC boundary before initializing source checkpoints.
# An empty value MUST block initial capture; do not default to all history.
EMAIL_BACKFILL_SINCE=

# Configure approved tenant, delegated API audience and executive identities.
TENANT_ID=
API_AUDIENCE=
# Optional per-user grants; the app role above is preferred.
EXECUTIVE_OBJECT_IDS=

# No secrets belong in Git. Runtime credentials/service endpoints are configured
# through infrastructure, managed identity and Key Vault during implementation.

# Email-release attachment contract: PDF only. No application consumes this yet.
# Actual-byte validation is required; a filename/MIME claim cannot establish type.
ATTACHMENT_ALLOWED_MIME_TYPES=application/pdf
PDF_OCR_ENABLED=true
# Existing conservative policy: unsupported files (including inline images) hold
# the occurrence from search. They are not extracted, converted or embedded.
ATTACHMENT_UNSUPPORTED_POLICY=hold_message
